# ---------------------------------------------------------------------------
# 运行产物（体积大，绝不入库）
# ---------------------------------------------------------------------------
# 一次完整下载+转写就会产生几百 MB，推上去会超 GitHub 的单文件/仓库体积限制
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# 模型缓存（small 约 484MB，medium 1.5GB）
models/

# 下载的媒体 / 提取的音频 / 生成的笔记
downloads/
audio/
output/
logs/

# 断点续跑的检查点与临时文件
*.segments.json
*.segments.tmp
*.source.json

# ---------------------------------------------------------------------------
# 对比实验的第三方项目副本与产物
# 这些是别人的代码（各有许可），不该混进本项目仓库
# ---------------------------------------------------------------------------
tube2note_env/
v2n_env/
vendor/
output_tube2note/
output_v2n/
obsidian_vault/

# ---------------------------------------------------------------------------
# 测试素材：体积大，需要时自己生成或另行提供
# ---------------------------------------------------------------------------
bench/*.wav
bench/*.mp4
bench/*.md
bench/*.json
bench/_*

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 本机诊断输出
diag_open.log
logs/gui.log