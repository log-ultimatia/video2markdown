[
 {
  "start": 0,
  "end": 6800,
  "text": "哈州旗子袆手 Boss Station customer"
 },
 {
  "start": 7800,
  "end": 11240,
  "text": "有人講甚麼呢?"
 },
 {
  "start": 13360,
  "end": 15140,
  "text": "可不是,一個名字"
 },
 {
  "start": 18040,
  "end": 20300,
  "text": "還是一個名字嗎?"
 },
 {
  "start": 20800,
  "end": 22840,
  "text": "反正當年現在分享的是"
 },
 {
  "start": 22940,
  "end": 24040,
  "text": "房販差大故事"
 },
 {
  "start": 27640,
  "end": 28760,
  "text": "我將你說出來的"
 },
 {
  "start": 28760,
  "end": 30760,
  "text": "上次我们检查是9月初"
 },
 {
  "start": 30760,
  "end": 32760,
  "text": "他说数学家要的其实有两样"
 },
 {
  "start": 32760,
  "end": 33760,
  "text": "答案和理解"
 },
 {
  "start": 33760,
  "end": 35760,
  "text": "以前这两样是绑在一起的"
 },
 {
  "start": 35760,
  "end": 37760,
  "text": "这一次答案先到了"
 },
 {
  "start": 208760,
  "end": 218760,
  "text": "数学界还有一个不成文的默契"
 },
 {
  "start": 218760,
  "end": 220760,
  "text": "有一批中等难度的题目"
 },
 {
  "start": 220760,
  "end": 222760,
  "text": "资深的人做得出来也不去碰"
 },
 {
  "start": 222760,
  "end": 224760,
  "text": "专门留给学生练手"
 },
 {
  "start": 224760,
  "end": 225760,
  "text": "在学界被看见"
 },
 {
  "start": 328760,
  "end": 337760,
  "text": "这批证明里有真东西"
 },
 {
  "start": 337760,
  "end": 338760,
  "text": "陶哲轩也承认"
 },
 {
  "start": 338760,
  "end": 339760,
  "text": "让他担心的是"
 },
 {
  "start": 339760,
  "end": 341760,
  "text": "证明一下子变多了"
 },
 {
  "start": 341760,
  "end": 342760,
  "text": "理解没有跟上"
 },
 {
  "start": 342760,
  "end": 344760,
  "text": "连留给学生练手的题目"
 },
 {
  "start": 344760,
  "end": 346760,
  "text": "也被一起炸掉"
 },
 {
  "start": 346760,
  "end": 348760,
  "text": "原影片将近20分钟"
 },
 {
  "start": 348760,
  "end": 349760,
  "text": "他还讲了两件事"
 },
 {
  "start": 349760,
  "end": 351760,
  "text": "一件是现在大家只顾加速"
 },
 {
  "start": 351760,
  "end": 352760,
  "text": "没人看得懂"
 },
 {
  "start": 352760,
  "end": 353760,
  "text": "他觉得撑不久"
 },
 {
  "start": 353760,
  "end": 355760,
  "text": "另一件是AI公司算不算敌人"
 },
 {
  "start": 355760,
  "end": 357760,
  "text": "他说大公司追AGI的竞赛"
 },
 {
  "start": 357760,
  "end": 359760,
  "text": "已经开始牺牲安全"
 },
 {
  "start": 359760,
  "end": 360760,
  "text": "原影片连接在说明栏"
 },
 {
  "start": 360760,
  "end": 362760,
  "text": "有兴趣可以去听更多"
 }
